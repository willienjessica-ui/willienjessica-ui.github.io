// GigGrow_SCHEMA_MASTER_V1.prisma
// Canonical production-grade schema for GigGrow

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  TERMINATED
  DISPUTED
}

enum VerificationType {
  IDENTITY
  WORK_AUTH
  BACKGROUND_CHECK
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  DISPUTED
}

enum MembershipTier {
  BASIC
  PREMIUM
}

enum SubscriptionTier {
  FREE
  BUSINESS
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  role          UserRole        @default(CLIENT)
  status        UserStatus      @default(PENDING_VERIFICATION)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  clientProfile   ClientProfile?
  providerProfile ProviderProfile?
  verifications   Verification[]
  usageLogs       UsageLog[]
  chatMessages    ChatMessage[]
}

model ClientProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  businessName  String?
  contactInfo   String?
  accountType   String   @default("INDIVIDUAL") // INDIVIDUAL or BUSINESS
  subscriptionTier SubscriptionTier @default(FREE)
  subscriptionExpiresAt DateTime?
  stripeCustomerId String?
  stripeSubscriptionId String?
  currentPeriodEnd DateTime?
  monthlyUsageCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobs          Job[]
  contracts     Contract[]
}

model ProviderProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  displayName   String?
  trade         String?
  serviceArea   String?
  experience    String?
  isPremium     Boolean  @default(false)
  membershipTier MembershipTier @default(BASIC)
  membershipExpiresAt DateTime?
  stripeCustomerId String?
  stripeSubscriptionId String?
  currentPeriodEnd DateTime?
  isContractorAcknowledged Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications  JobApplication[]
  contracts     Contract[]
}

model UsageLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  action        String   // e.g., "AI_ESTIMATE"
  metadata      String?  // JSON string for additional context
  createdAt     DateTime @default(now())
}

model Job {
  id            String    @id @default(uuid())
  clientId      String
  client        ClientProfile @relation(fields: [clientId], references: [id])
  title         String
  description   String
  category      String
  location      String?
  budgetType    String    @default("FIXED") // FIXED or HOURLY
  budgetMin     Float?
  budgetMax     Float?
  status        JobStatus @default(OPEN)
  isPublic      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  applications  JobApplication[]
  contract      Contract?
}

model JobApplication {
  id            String            @id @default(uuid())
  jobId         String
  job           Job               @relation(fields: [jobId], references: [id])
  providerId    String
  provider      ProviderProfile   @relation(fields: [providerId], references: [id])
  proposal      String
  bidAmount     Float?
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Contract {
  id            String         @id @default(uuid())
  jobId         String         @unique
  job           Job            @relation(fields: [jobId], references: [id])
  clientId      String
  client        ClientProfile  @relation(fields: [clientId], references: [id])
  providerId    String
  provider      ProviderProfile @relation(fields: [providerId], references: [id])
  termsSnapshot String?
  status        ContractStatus @default(ACTIVE)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  evidenceItems EvidenceItem[]
  payments      PaymentRecord[]
  timeEntries   TimeEntry[]
  materialLines MaterialLine[]
  chatMessages  ChatMessage[]
  tasks         Task[]
}

model Task {
  id            String   @id @default(uuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id])
  description   String
  isCompleted   Boolean  @default(false)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Verification {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  type          VerificationType
  status        VerificationStatus @default(PENDING)
  metadata      String?            // JSON string for document metadata
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model EvidenceItem {
  id            String   @id @default(uuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id])
  type          String   // PHOTO, DOCUMENT, RECEIPT, NOTE
  url           String
  hash          String?
  description   String?
  createdAt     DateTime @default(now())
}

model PaymentRecord {
  id              String        @id @default(uuid())
  contractId      String
  contract        Contract      @relation(fields: [contractId], references: [id])
  amount          Float
  fee             Float
  status          PaymentStatus @default(PENDING)
  currency        String        @default("usd")
  stripeIntentId  String?       @unique
  lumosAdvisoryId String?
  lumosRiskClass  String?
  payerUserId     String?
  payeeProviderId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  events          PaymentEvent[]
}

model PaymentEvent {
  id              String   @id @default(uuid())
  paymentRecordId String
  paymentRecord   PaymentRecord @relation(fields: [paymentRecordId], references: [id])
  fromStatus      PaymentStatus?
  toStatus        PaymentStatus
  actor           String?  // userId or "SYSTEM"
  source          String   // STRIPE_WEBHOOK | CONFIRM | REFUND | ADMIN
  createdAt       DateTime @default(now())
}

model TimeEntry {
  id            String   @id @default(uuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id])
  hours         Float
  description   String?
  date          DateTime
  createdAt     DateTime @default(now())
}

model MaterialLine {
  id            String   @id @default(uuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id])
  item          String
  cost          Float
  createdAt     DateTime @default(now())
}

model ChatMessage {
  id            String   @id @default(uuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id])
  senderId      String
  sender        User     @relation(fields: [senderId], references: [id])
  content       String
  createdAt     DateTime @default(now())
}
