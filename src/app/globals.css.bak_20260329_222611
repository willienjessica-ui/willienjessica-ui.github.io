/* globals.css */

/* Reset-ish */
*,
*::before,
*::after {
  box-sizing: border-box;
}

:root {
  --navy: #0A192F;
  --crimson: #8E0E0E;
  --white: #F7F7F7;
  --gold: #D4AF37;
  --gold-glow: rgba(212, 175, 55, 0.4);
}

html,
body {
  padding: 0;
  margin: 0;
  font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #050507;
  color: #f7f7f7;
}

/* Layout */
.site-wrapper {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-image: 
    linear-gradient(to bottom, rgba(10, 25, 47, 0.95), rgba(5, 5, 7, 0.98)),
    url('https://www.transparenttextures.com/patterns/dark-leather.png');
}

.site-main {
  flex: 1;
  max-width: 1200px;
  margin: 0 auto;
  padding: 1.5rem 1.25rem 3rem;
}

/* Header */
.site-header {
  border-bottom: 2px solid var(--gold);
  padding: 1rem 1.25rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  background: linear-gradient(90deg, var(--navy) 0%, #050507 100%);
  box-shadow: 0 4px 20px rgba(0,0,0,0.5);
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 1rem;
}

/* BIGGER CREST LOGO */
.brand-crest {
  width: 120px;
  height: 120px;
  border-radius: 999px;
  border: 3px solid var(--gold);
  object-fit: cover;
  background: radial-gradient(circle, var(--gold) 0%, var(--navy) 100%);
  box-shadow: 0 0 25px var(--gold-glow);
}

.brand-name {
  margin: 0;
  font-size: 1.8rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: linear-gradient(135deg, var(--white) 0%, var(--gold) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.brand-tagline {
  margin: 0;
  font-size: 0.9rem;
  color: var(--gold);
  font-style: italic;
  font-weight: 600;
}

/* Hero */
.hero-section {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(0, 1.3fr);
  gap: 3rem;
  margin-top: 4rem;
  align-items: center;
}

.hero-title {
  font-size: 3.5rem;
  line-height: 1;
  margin-bottom: 1.5rem;
  font-weight: 900;
  text-transform: uppercase;
  background: linear-gradient(to bottom, #fff 0%, #ccc 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitle {
  font-size: 1.25rem;
  color: #d6d6d6;
  max-width: 40rem;
  line-height: 1.6;
}

/* Buttons */
.btn-primary {
  background: linear-gradient(135deg, var(--crimson) 0%, #5a0808 100%);
  color: white;
  border: 2px solid var(--gold);
  padding: 1rem 2rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  box-shadow: 0 5px 15px rgba(142, 14, 14, 0.4);
}

.btn-primary:hover {
  transform: scale(1.05);
  box-shadow: 0 8px 25px rgba(142, 14, 14, 0.6);
}

.btn-secondary {
  background: var(--navy);
  border: 2px solid var(--gold);
  color: var(--white);
  padding: 1rem 2rem;
  font-weight: 700;
  text-transform: uppercase;
}

/* AI DEBBIE FLOATING WIDGET */
.debbie-concierge {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.debbie-avatar {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  border: 3px solid var(--gold);
  box-shadow: 0 0 20px var(--gold-glow);
  cursor: pointer;
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.debbie-avatar:hover {
  transform: scale(1.1) rotate(5deg);
}

.debbie-bubble {
  background: var(--white);
  color: var(--navy);
  padding: 0.75rem 1.25rem;
  border-radius: 1.5rem 1.5rem 0 1.5rem;
  margin-bottom: 1rem;
  font-weight: 600;
  font-size: 0.9rem;
  box-shadow: 0 10px 25px rgba(0,0,0,0.3);
  max-width: 250px;
  border: 2px solid var(--gold);
}

/* Layout */
.site-wrapper {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.site-main {
  flex: 1;
  max-width: 1200px;
  margin: 0 auto;
  padding: 1.5rem 1.25rem 3rem;
}

/* Header */
.site-header {
  border-bottom: 1px solid rgba(255, 215, 0, 0.25);
  padding: 0.75rem 1.25rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  background: radial-gradient(circle at top left, #3b2b10 0, #050507 55%);
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

/* BIGGER CREST LOGO */
.brand-crest {
  width: 110px;
  height: 110px;
  border-radius: 999px;
  border: 2px solid #d4af37;
  object-fit: cover;
  background: radial-gradient(circle, #d4af37 0, #4b3a16 55%, #050507 100%);
}

/* On small phones, shrink just a bit but keep it prominent */
@media (max-width: 480px) {
  .brand-crest {
    width: 90px;
    height: 90px;
  }
}

.brand-name {
  margin: 0;
  font-size: 1.35rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.brand-tagline {
  margin: 0;
  font-size: 0.8rem;
  color: #e5c97a;
}

.main-nav {
  display: flex;
  gap: 1rem;
  font-size: 0.9rem;
}

.main-nav a {
  text-decoration: none;
  color: #f7f7f7;
  position: relative;
  padding-bottom: 0.2rem;
}

.main-nav a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 0;
  height: 2px;
  background: linear-gradient(90deg, #d4af37, #f7e27b);
  transition: width 0.22s ease-out;
}

.main-nav a:hover::after {
  width: 100%;
}

/* Hero */
.hero-section {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(0, 1.3fr);
  gap: 2rem;
  margin-top: 2rem;
  align-items: center;
}

.hero-title {
  font-size: 2.2rem;
  line-height: 1.1;
  margin-bottom: 0.75rem;
  background: linear-gradient(120deg, #fdf5be, #d4af37, #f7e27b);
  -webkit-background-clip: text;
  color: transparent;
}

.hero-subtitle {
  font-size: 1rem;
  color: #d6d6d6;
  max-width: 36rem;
}

.hero-cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 1.25rem;
}

/* Buttons */
.btn-primary,
.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.55rem 1.2rem;
  border-radius: 999px;
  font-size: 0.9rem;
  text-decoration: none;
  cursor: pointer;
  border: 1px solid transparent;
  transition: transform 0.12s ease-out, box-shadow 0.12s ease-out, background 0.12s;
}

.btn-primary {
  background: linear-gradient(135deg, #d4af37, #f7e27b);
  color: #201a09;
  box-shadow: 0 0 20px rgba(244, 211, 94, 0.25);
}

.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 0 28px rgba(244, 211, 94, 0.38);
}

.btn-secondary {
  background: transparent;
  border-color: #d4af37;
  color: #f7f7f7;
}

.btn-secondary:hover {
  background: rgba(212, 175, 55, 0.1);
}

/* Hero panel - gold frame */
.hero-panel {
  display: flex;
  justify-content: center;
}

.gold-frame {
  border-radius: 24px;
  padding: 2px;
  background: linear-gradient(135deg, #fdf5be, #d4af37, #f7e27b, #8c6b1f);
  box-shadow: 0 0 30px rgba(0, 0, 0, 0.65);
}

.gold-inner {
  border-radius: 22px;
  padding: 1.5rem 1.25rem;
  background: radial-gradient(circle at top, #2b2310 0, #0b0b0d 55%);
  max-width: 320px;
}

.gold-text {
  margin: 0;
  color: #f8f3da;
  font-size: 0.95rem;
  text-align: center;
}

/* Sections */
.section-block {
  margin-top: 3rem;
}

.section-title {
  font-size: 1.4rem;
  margin-bottom: 1.25rem;
  border-left: 3px solid #d4af37;
  padding-left: 0.5rem;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.1rem;
}

.info-card,
.product-card {
  border-radius: 18px;
  padding: 1rem;
  background: radial-gradient(circle at top left, #292018 0, #101013 65%);
  border: 1px solid rgba(212, 175, 55, 0.15);
  box-shadow: 0 0 12px rgba(0, 0, 0, 0.6);
}

.info-card h4,
.product-card h4 {
  margin-top: 0;
  margin-bottom: 0.4rem;
  font-size: 1rem;
  color: #f5e0a1;
}

.info-card p,
.product-card p {
  margin: 0.25rem 0;
  font-size: 0.9rem;
  color: #d0d0d0;
}

.product-meta {
  font-size: 0.8rem;
  color: #f5e0a1;
}

/* Two-column blocks */
.two-column {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 1.25rem;
  font-size: 0.95rem;
  color: #d0d0d0;
}

/* Contact */
.bullet-list {
  margin: 0.5rem 0 0;
  padding-left: 1.2rem;
  font-size: 0.9rem;
}

.contact-box {
  border-radius: 18px;
  padding: 1rem;
  border: 1px solid rgba(212, 175, 55, 0.3);
  background: radial-gradient(circle at top left, #302416 0, #101012 65%);
  font-size: 0.9rem;
}

/* Footer */
.site-footer {
  border-top: 1px solid rgba(255, 215, 0, 0.2);
  padding: 0.75rem 1.25rem 1rem;
  font-size: 0.8rem;
  color: #b0b0b0;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem;
  background: #050507;
}

.footer-contact {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

/* Responsive */
@media (max-width: 800px) {
  .hero-section {
    grid-template-columns: 1fr;
  }

  .site-main {
    padding: 1rem 0.75rem 2.5rem;
  }

  .main-nav {
    display: none; /* we can add a mobile menu later */
  }
}
